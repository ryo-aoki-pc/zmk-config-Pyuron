#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/bt.h>
#include <input/processors.dtsi>
#include <physical_layouts.dtsi>

&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

split_inputs {
      #address-cells = <1>;
      #size-cells = <0>;

      trackball_split_L: trackball_split_L@0 {
        compatible = "zmk,input-split";
        reg = <0>;
      };
    };

    /*
     * カーソルの加速 (zmk-input-processor-xy-accel)。ボールを転がす速さ (カウント/秒) に応じて
     * 移動量に倍率 (1000 = 等倍) を掛ける。速さ 0 で min-factor、speed-threshold で等倍、
     * speed-max 以上で max-factor になり、その間は直線で補間する。ゆっくり動かしたときは
     * カーソルを細かく動かし、速く動かしたときは遠くまで動かす。
     * 左右のトラックボールのリスナーで共有する (状態はリスナーごとに持つので、速さは混ざらない)。
     * ゆっくり動かしたときに遅すぎれば min-factor を上げ、速く動かしたときに飛びすぎれば
     * (Windows の「ポインターの精度を高める」と重なるときなど) max-factor を下げる (1000 で加速なし)
     */
    trackball_accel: trackball_accel {
        compatible = "zmk,input-processor-xy-accel";
        #input-processor-cells = <0>;
        min-factor = <500>;
        max-factor = <1300>;
        speed-threshold = <1000>;
        speed-max = <4000>;
    };

    /*
     * 両トラックボール共通の挙動：
     *   通常レイヤー       → base の input-processors（カーソル移動）。
     *   SCRL(9) レイヤー時  → 子ノード scroller_* の input-processors（スクロール）。
     * input-listener は「マッチした子ノードが base を置換」する（process-next は付けない）
     * ため、子ノードは自己完結チェーンとして必要な processor を全て列挙する。
     * 各チェーン先頭の zip_temp_layer 8 でスクロール中も MOUS(8) を維持する。
     */
    trackball_listener_L: trackball_listener_L {
      compatible = "zmk,input-listener";
      status = "disabled";
      device = <&trackball_split_L>;

        // 通常: カーソル移動（AML自動有効化 + 軸補正 + 加速。左カーソルは上下反転のため Y_INVERT を外す）
        input-processors = <&zip_temp_layer 8 10000>,  // 8 = MOUS
                           <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)>,
                           <&trackball_accel>;

        // SCRL(9) ではスクロール
        scroller_L {
            layers = <9>;  // 9 = SCRL
            input-processors = <&zip_temp_layer 8 10000>,
                               <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
                               <&zip_xy_to_scroll_mapper>,
                               <&zip_scroll_scaler 1 16>;
        };
    };

    trackball_listener_R: trackball_listener_R {
      compatible = "zmk,input-listener";
      status = "disabled";

        // 通常: カーソル移動（AML自動有効化 + 軸補正 + 加速）
        input-processors = <&zip_temp_layer 8 10000>,  // 8 = MOUS
                           <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>,
                           <&trackball_accel>;

        // SCRL(9) ではスクロール（縦スクロールは反転のため Y_INVERT を外す）
        scroller_R {
            layers = <9>;  // 9 = SCRL
            input-processors = <&zip_temp_layer 8 10000>,
                               <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)>,
                               <&zip_xy_to_scroll_mapper>,
                               <&zip_scroll_scaler 1 16>;
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <4>;               
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(3,4)     RC(3,6) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
            RC(3,0) RC(3,1)                 RC(3,2) RC(3,3)     RC(3,7) RC(3,8)                 RC(3,9) RC(3,10)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
        wakeup-source;

            row-gpios
                = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
                , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
                , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
                , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 			
                ;
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  800    0       0     0     0>
            , <&key_physical_attrs 100 100  900    0       0     0     0>
            , <&key_physical_attrs 100 100 1000    0       0     0     0>
            , <&key_physical_attrs 100 100 1100    0       0     0     0>
            , <&key_physical_attrs 100 100 1200    0       0     0     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  100       0     0     0>
            , <&key_physical_attrs 100 100  800  100       0     0     0>
            , <&key_physical_attrs 100 100  900  100       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100 1100  100       0     0     0>
            , <&key_physical_attrs 100 100 1200  100       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  200       0     0     0>
            , <&key_physical_attrs 100 100  500  200       0     0     0>
            , <&key_physical_attrs 100 100  700  200       0     0     0>
            , <&key_physical_attrs 100 100  800  200       0     0     0>
            , <&key_physical_attrs 100 100  900  200       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100 1100  200       0     0     0>
            , <&key_physical_attrs 100 100 1200  200       0     0     0>
            , <&key_physical_attrs 100 100    0  300       0     0     0>
            , <&key_physical_attrs 100 100  100  300       0     0     0>
            , <&key_physical_attrs 100 100  400  300       0     0     0>
            , <&key_physical_attrs 100 100  500  300       0     0     0>
            , <&key_physical_attrs 100 100  700  300       0     0     0>
            , <&key_physical_attrs 100 100  800  300       0     0     0>
            , <&key_physical_attrs 100 100 1100  300       0     0     0>
            , <&key_physical_attrs 100 100 1200  300       0     0     0>
            ;
    };
};